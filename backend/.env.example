# Gemini AI (required) - get free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Twitter/X API (optional - needed only for posting tweets)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Scheduler: how often to auto-fetch news (in hours)
NEWS_FETCH_INTERVAL_HOURS=2

# X Premium long posts (default 25000). Free tier would use 280.
MAX_TWEET_LENGTH=25000
# Soft target length for AI-generated drafts
AI_TWEET_TARGET_LENGTH=800
