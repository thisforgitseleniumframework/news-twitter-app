{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Grok: Start agent",
      "type": "shell",
      "command": "grok",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false,
        "group": "grok"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Grok: Continue last session",
      "type": "shell",
      "command": "grok -c",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "group": "grok"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Grok: Start (always-approve)",
      "type": "shell",
      "command": "grok --yolo",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "group": "grok"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Grok: New session",
      "type": "shell",
      "command": "grok",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "group": "grok"
      }
    }
  ]
}
